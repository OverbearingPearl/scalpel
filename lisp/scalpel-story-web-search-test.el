;;; scalpel-story-web-search-test.el --- web-search tests -*- lexical-binding: t; -*-

;;; Commentary:

;; User-perspective GWT stories for the web-search tool: zhipu request
;; and parsing, unregistered engine rejection, curl failure report and
;; action validation.  Names are generated by ert-gwt.

;;; Code:

(require 'ert)
(require 'ert-gwt)
(require 'cl-lib)
(require 'scalpel-agent)

;; Names are generated by ert-gwt from the clause content; never
;; spelled by hand.

(ert-gwt-deftest
    (:given ((captured-args nil)
             (report nil)
             (fake-json
              "{\"search_result\":[{\"title\":\"T1\",\"url\":\"https://e/1\",\"content\":\"C1\"}]}")))
    (:when
     (cl-letf (((symbol-function 'call-process)
                (lambda (_p _in buf _display &rest args)
                  (setq captured-args args)
                  (with-current-buffer buf (insert fake-json))
                  0))
               ((symbol-function 'auth-source-pick-first-password)
                (lambda (&rest _) "test-token")))
       (setq report (scalpel-agent-web-search "q" "zhipu"))))
    (:then
     (ert-info ((format "Report must be a non-empty string; got: %s"
                        (format "%s" report)))
       (should (stringp report))
       (should (> (length report) 0)))
     (ert-info ("Curl args carry POST body and bearer header")
       (should (member "-X" captured-args))
       (should (member "POST" captured-args))
       (should (member "-d" captured-args))
       (should (member "Authorization: Bearer test-token"
                       captured-args)))
     (ert-info ("Engine line is rendered from zhipu :parse output")
       (should (string-match-p "Engine: zhipu" report)))
     (ert-info ("Title T1 appears from zhipu :parse output")
       (should (string-match-p "T1" report)))
     (ert-info ("Link https://e/1 appears from zhipu :parse output")
       (should (string-match-p "https://e/1" report)))
     (ert-info ("Content C1 appears from zhipu :parse output")
       (should (string-match-p "C1" report)))
     (ert-info ((format "Raw JSON key search_result must not leak; report seen by string-match-p: %S" report))
       (should (null (string-match-p "search_result" report))))))

(ert-gwt-deftest
    (:given ((err nil)))
    (:when
     (setq err
           (condition-case e
               (progn (scalpel-agent-web-search "q" "no-such-engine")
                      nil)
             (user-error (car e)))))
    (:then
     (should (eq err 'user-error))))

(ert-gwt-deftest
    (:given ((report nil)))
    (:when
     (cl-letf (((symbol-function 'call-process)
                (lambda (_p _in buf _args &rest _)
                  (with-current-buffer buf (insert "curl: (7) refused"))
                  7))
               ((symbol-function 'auth-source-pick-first-password)
                (lambda (&rest _) "test-token")))
       (setq report (scalpel-agent-web-search "q" "zhipu"))))
    (:then
     (ert-info ("Exit 7 yields the error report")
       (should (string-match-p "Exit: 7" report))
       (should (string-match-p "Error: curl exited non-zero"
                               report)))))

(ert-gwt-deftest
    (:given ((valid nil)))
    (:when
     (setq valid (scalpel-agent--validate-action
                  (list :tool "web-search" :query "q" :engine "duckduckgo"))))
    (:then
     (ert-info ("web-search action with all required fields passes validation and projects per field contract")
       (should (equal (plist-get valid :tool) "web-search"))
       (should (equal (plist-get valid :query) "q"))
       (should (equal (plist-get valid :engine) "duckduckgo"))
       (should (equal valid '(:tool "web-search" :query "q" :engine "duckduckgo"))))))

(provide 'scalpel-story-web-search-test)

;;; scalpel-story-web-search-test.el ends here
