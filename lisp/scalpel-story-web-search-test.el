;;; scalpel-story-web-search-test.el --- web-search tests -*- lexical-binding: t; -*-

;;; Commentary:

;; User-perspective GWT stories for the web-search tool: zhipu request
;; and parsing, unregistered engine rejection, curl failure report and
;; action validation.  Names are generated by ert-gwt.

;;; Code:

(require 'ert)
(require 'ert-gwt)
(require 'cl-lib)
(require 'scalpel-agent)

;; Names are generated by ert-gwt from the clause content; never
;; spelled by hand.

(defvar scalpel-story-web-search-test--captured-command nil
  "Command line recorded by the most recent fake `make-process' stub.
Set by `scalpel-story-web-search-test--web-search-with-fake-process' so
tests can inspect the arguments passed to curl without touching a real
process.")

(defun scalpel-story-web-search-test--web-search-with-fake-process
    (buffer-text exit-status call)
  "Isolate CALL from curl process and auth-source access during test.
The fake process is the :buffer passed to `make-process', writes
BUFFER-TEXT into that buffer, and reports EXIT-STATUS.  The `make-process'
stub records the :command plist value into the global variable
`scalpel-story-web-search-test--captured-command', which CALL reads
directly; CALL takes no argument and may inspect that variable at any time
after the `make-process' stub has run, including before the sentinel fires.
The stubs cover `make-process', `process-status', `process-exit-status',
`process-live-p', `process-buffer', `delete-process', and
`auth-source-pick-first-password'; `process-buffer' returns the fake
process buffer without consulting the real primitive.  All original
function cells are restored on exit, and the fake process buffer is
killed."
  (let ((saved (mapcar (lambda (sym) (cons sym (symbol-function sym)))
                       (list 'make-process 'process-status
                             'process-exit-status 'process-live-p
                             'process-buffer 'delete-process
                             'auth-source-pick-first-password)))
        fake-buf sentinel)
    (unwind-protect
        (progn
          (fset 'make-process
                (lambda (&rest props)
                  (setq scalpel-story-web-search-test--captured-command
                        (plist-get props :command))
                  (setq fake-buf (plist-get props :buffer))
                  (setq sentinel (plist-get props :sentinel))
                  (with-current-buffer fake-buf (insert buffer-text))
                  fake-buf))
          (fset 'process-status (lambda (_p) 'exit))
          (fset 'process-exit-status (lambda (_p) exit-status))
          (fset 'process-live-p (lambda (_p) nil))
          (fset 'process-buffer (lambda (_p) fake-buf))
          (fset 'delete-process (lambda (_p) nil))
          (fset 'auth-source-pick-first-password
                (lambda (&rest _) "test-token"))
          (funcall call)
          (when sentinel
            (funcall sentinel fake-buf "finished\n")))
      (dolist (pair saved)
        (fset (car pair) (cdr pair)))
      (when (and fake-buf (buffer-live-p fake-buf))
        (kill-buffer fake-buf)))))

(ert-gwt-deftest
    (:given ((report nil)
             (errors nil)
             (args nil)
             (fake-json
              "{\"search_result\":[{\"title\":\"T1\",\"url\":\"https://e/1\",\"content\":\"C1\"}]}")))
    (:when
     (progn
       (scalpel-story-web-search-test--web-search-with-fake-process
        fake-json 0
        (lambda ()
          (scalpel-agent-web-search
           "q" "zhipu"
           (lambda (result) (setq report result))
           (lambda (err) (setq errors err)))))
       (setq args scalpel-story-web-search-test--captured-command)))
    (:then
     (ert-info ("async curl delivers parsed report and captured args")
       (should (stringp report))
       (should (> (length report) 0))
       (should (eq errors nil))
       (let ((printed (format "%s" args)))
         (should (string-match-p "-X POST" printed))
         (should (string-match-p "-d" printed))
         (should (string-match-p "Authorization: Bearer test-token" printed)))
       (should (string-match-p "Engine: zhipu" report))
       (should (string-match-p "T1" report))
       (should (string-match-p "https://e/1" report))
       (should (string-match-p "C1" report))
       (should (not (string-match-p "search_result" report))))))

(ert-gwt-deftest
    (:given ((err nil)))
    (:when
     (setq err
           (condition-case e
               (progn (scalpel-agent-web-search
                       "q" "no-such-engine"
                       (lambda (_r) nil)
                       (lambda (_e) nil))
                      nil)
             (user-error (car e)))))
    (:then
     (should (eq err 'user-error))))

(ert-gwt-deftest
    (:given ((report nil)
             (errors nil)))
    (:when
     (scalpel-story-web-search-test--web-search-with-fake-process
      "curl: (7) refused" 7
      (lambda ()
        (scalpel-agent-web-search
         "q" "zhipu"
         (lambda (result) (setq report result))
         (lambda (err) (setq errors err))))))
    (:then
     (ert-info ("curl failure is reported as nonempty report with empty errors")
       (should (stringp report))
       (should (> (length report) 0))
       (should (eq errors nil))
       (should (string-match-p "curl" report)))))

(ert-gwt-deftest
    (:given ((valid nil)))
    (:when
     (setq valid (scalpel-agent--validate-action
                  (list :tool "web-search" :query "q" :engine "zhipu"))))
    (:then
     (ert-info ("web-search action with all required fields passes validation and projects per field contract")
       (should (equal (plist-get valid :tool) "web-search"))
       (should (equal (plist-get valid :query) "q"))
       (should (equal (plist-get valid :engine) "zhipu"))
       (should (equal valid (list :tool "web-search" :query "q" :engine "zhipu"))))))

(provide 'scalpel-story-web-search-test)

;;; scalpel-story-web-search-test.el ends here
